"VertexLitGeneric"
{
    "$basetexture" "models/redimated/herobrine/herobrinetexture"
    "$bumpmap" "models/redimated/herobrine/shared_n"
    "$nodecal" "1"
    "$phong" "1"
    "$phongboost"    "0"
    "$phongexponent" "10"
    "$phongfresnelranges"    "[0.1 0.23 0.945]"
    "$phongdisablehalflambert"    "0"
    "$color2" "[1 1 1]"
    "$alphatest" "0"

    "$envmap" "env_cubemap"
    "$normalmapalphaenvmapmask"        "1"
    "$envmapfresnel"    "1"

    "$envmaptint"        0

$nocull 1
}